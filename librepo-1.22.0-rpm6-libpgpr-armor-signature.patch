+/* Fallback ASCII-Armor signature decoder for rpm >= 6 with libpgpr, whose
+ * pgpParsePkts() only accepts "PUBLIC KEY BLOCK" and rejects SIGNATURE blocks.
+ */
+static pgpArmor
+dearmor_pgp_signature(const char *armor, uint8_t **pkts, size_t *pkts_len) {
+    static const char footer[] = "-----END PGP SIGNATURE-----";
+    const size_t header_len = strlen(BEGIN_OPENPGP_SIGNATURE);
+    const size_t footer_len = sizeof(footer) - 1;
+
+    if (strncmp(armor, BEGIN_OPENPGP_SIGNATURE, header_len) != 0) {
+        return PGPARMOR_ERR_NO_BEGIN_PGP;
+    }
+    const char *p = armor + header_len;
+    if (*p == '\r') ++p;
+    if (*p != '\n') {
+        return PGPARMOR_ERR_NO_BEGIN_PGP;
+    }
+    ++p;
+
+    // Skip armor headers up to blank separator line
+    while (*p != '\0') {
+        const char *nl = strchr(p, '\n');
+        if (!nl) {
+            return PGPARMOR_ERR_NO_END_PGP;
+        }
+        size_t stripped_len = (size_t)(nl - p);
+        if (stripped_len > 0 && p[stripped_len - 1] == '\r') {
+            --stripped_len;
+        }
+        if (stripped_len == 0) {
+            p = nl + 1;
+            break;
+        }
+        if (memchr(p, ':', stripped_len) == NULL) {
+            return PGPARMOR_ERR_UNKNOWN_PREAMBLE_TAG;
+        }
+        p = nl + 1;
+    }
+
+    const char *body_start = p;
+    const char *body_end = NULL;
+    gboolean found_crc = FALSE;
+    uint32_t expected_crc = 0;
+
+    while (*p != '\0') {
+        if (*p == '=' || strncmp(p, footer, footer_len) == 0) {
+            body_end = p;
+            if (*p == '=') {
+                found_crc = TRUE;
+                if (strlen(p) < 5) {
+                    return PGPARMOR_ERR_CRC_DECODE;
+                }
+                int v0 = b64_char_val((unsigned char)p[1]);
+                int v1 = b64_char_val((unsigned char)p[2]);
+                int v2 = b64_char_val((unsigned char)p[3]);
+                int v3 = b64_char_val((unsigned char)p[4]);
+                if (v0 < 0 || v1 < 0 || v2 < 0 || v3 < 0) {
+                    return PGPARMOR_ERR_CRC_DECODE;
+                }
+                expected_crc = ((uint32_t)v0 << 18) | ((uint32_t)v1 << 12) |
+                               ((uint32_t)v2 << 6) | (uint32_t)v3;
+                p += 5;
+                if (*p == '\r') ++p;
+                if (*p != '\n') {
+                    return PGPARMOR_ERR_CRC_DECODE;
+                }
+                ++p;
+            }
+            if (strncmp(p, footer, footer_len) != 0) {
+                return PGPARMOR_ERR_NO_END_PGP;
+            }
+            p += footer_len;
+            if (*p == '\r') ++p;
+            if (*p != '\n' && *p != '\0') {
+                return PGPARMOR_ERR_NO_END_PGP;
+            }
+            break;
+        }
+        const char *nl = strchr(p, '\n');
+        if (!nl) {
+            return PGPARMOR_ERR_NO_END_PGP;
+        }
+        p = nl + 1;
+    }
+
+    if (body_end == NULL) {
+        return PGPARMOR_ERR_NO_END_PGP;
+    }
+
+    uint8_t *decoded = NULL;
+    size_t decoded_len = 0;
+    pgpArmor dec_rc = decode_base64_body(body_start, body_end, &decoded, &decoded_len);
+    if (dec_rc < 0) {
+        return dec_rc;
+    }
+
+    if (found_crc && pgp_crc24(decoded, decoded_len) != expected_crc) {
+        free(decoded);
+        return PGPARMOR_ERR_CRC_CHECK;
+    }
+
+    *pkts = decoded;
+    *pkts_len = decoded_len;
+    return PGPARMOR_SIGNATURE;
+}
