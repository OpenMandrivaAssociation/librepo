+static int
+b64_char_val(unsigned char c) {
+    if (c >= 'A' && c <= 'Z') return c - 'A';
+    if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+    if (c >= '0' && c <= '9') return c - '0' + 52;
+    if (c == '+') return 62;
+    if (c == '/') return 63;
+    return -1;
+}
+
+static uint32_t
+pgp_crc24(const uint8_t *octets, size_t len) {
+    uint32_t crc = 0xb704ceU;
+    for (size_t i = 0; i < len; ++i) {
+        crc ^= (uint32_t)octets[i] << 16;
+        for (int b = 0; b < 8; ++b) {
+            crc <<= 1;
+            if (crc & 0x1000000U) {
+                crc ^= 0x1864cfbU;
+            }
+        }
+    }
+    return crc & 0xffffffU;
+}
+
+static pgpArmor
+decode_base64_body(const char *start, const char *end, uint8_t **out, size_t *out_len) {
+    size_t raw_len = (size_t)(end - start);
+    g_autofree gchar *b64_clean = g_malloc(raw_len + 1);
+    size_t idx = 0;
+    for (const char *q = start; q < end; ++q) {
+        if (*q == '\r' || *q == '\n') {
+            continue;
+        }
+        if (b64_char_val((unsigned char)*q) < 0 && *q != '=') {
+            return PGPARMOR_ERR_BODY_DECODE;
+        }
+        b64_clean[idx++] = *q;
+    }
+    if (idx == 0 || (idx % 4) != 0) {
+        return PGPARMOR_ERR_BODY_DECODE;
+    }
+    b64_clean[idx] = '\0';
+
+    uint8_t *buf = malloc((idx / 4) * 3);
+    if (!buf) {
+        return PGPARMOR_ERR_BODY_DECODE;
+    }
+
+    size_t decoded_len = 0;
+    gboolean seen_pad = FALSE;
+    for (size_t i = 0; i < idx; i += 4) {
+        if (seen_pad) {
+            free(buf);
+            return PGPARMOR_ERR_BODY_DECODE;
+        }
+        int c0 = b64_char_val((unsigned char)b64_clean[i]);
+        int c1 = b64_char_val((unsigned char)b64_clean[i + 1]);
+        if (c0 < 0 || c1 < 0) {
+            free(buf);
+            return PGPARMOR_ERR_BODY_DECODE;
+        }
+        char p2 = b64_clean[i + 2];
+        char p3 = b64_clean[i + 3];
+        if (p2 == '=') {
+            if (p3 != '=') {
+                free(buf);
+                return PGPARMOR_ERR_BODY_DECODE;
+            }
+            seen_pad = TRUE;
+            buf[decoded_len++] = (uint8_t)((c0 << 2) | (c1 >> 4));
+        } else {
+            int c2 = b64_char_val((unsigned char)p2);
+            if (c2 < 0) {
+                free(buf);
+                return PGPARMOR_ERR_BODY_DECODE;
+            }
+            if (p3 == '=') {
+                seen_pad = TRUE;
+                buf[decoded_len++] = (uint8_t)((c0 << 2) | (c1 >> 4));
+                buf[decoded_len++] = (uint8_t)(((c1 & 0x0f) << 4) | (c2 >> 2));
+            } else {
+                int c3 = b64_char_val((unsigned char)p3);
+                if (c3 < 0) {
+                    free(buf);
+                    return PGPARMOR_ERR_BODY_DECODE;
+                }
+                buf[decoded_len++] = (uint8_t)((c0 << 2) | (c1 >> 4));
+                buf[decoded_len++] = (uint8_t)(((c1 & 0x0f) << 4) | (c2 >> 2));
+                buf[decoded_len++] = (uint8_t)(((c2 & 0x03) << 6) | c3);
+            }
+        }
+    }
+
+    *out = buf;
+    *out_len = decoded_len;
+    return PGPARMOR_SIGNATURE;
+}
